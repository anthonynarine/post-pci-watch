# # Filename: .env.example
#
# Variable NAMES only. Never commit values — .gitignore excludes .env* for that reason.
# Copy to .env.local and fill in from the Clerk and Convex dashboards, or let the CLIs
# write them: `npx clerk init` and `npx convex dev`.
#
# Which side each variable belongs to matters. NEXT_PUBLIC_* is compiled into the browser
# bundle and is public by design; everything else stays on a server.

# ---------------------------------------------------------------------------
# Clerk — read by the Next.js server and browser
# ---------------------------------------------------------------------------

# Public. Also encodes the Clerk frontend API origin, which next.config.ts decodes to build
# the Content-Security-Policy. A missing value blocks every Clerk script.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# SECRET. Server only. Never expose, never prefix with NEXT_PUBLIC_.
CLERK_SECRET_KEY=

# Route configuration for Clerk's hosted components.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=

# ---------------------------------------------------------------------------
# Convex — read by the Next.js browser bundle and the Convex CLI
# ---------------------------------------------------------------------------

# Identifies which deployment `npx convex dev` targets.
CONVEX_DEPLOYMENT=

# Public. The browser needs it to open the WebSocket. next.config.ts derives both the
# https:// and wss:// entries of the CSP connect-src from this value.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# ---------------------------------------------------------------------------
# Set on the CONVEX DEPLOYMENT, not in this file
# ---------------------------------------------------------------------------
#
# CLERK_FRONTEND_API_URL — the issuer convex/auth.config.ts trusts. Set it with
#   `npx convex env set CLERK_FRONTEND_API_URL https://<your-clerk-frontend-api>`
#
# If it is missing, ctx.auth.getUserIdentity() returns null forever, every protected query
# fails with "Not authenticated", and the browser console stays silent. Check
# `npx convex logs` first when authenticated queries fail for no visible reason.
